# LLM Wiki Environment Configuration (Optional)
# Copy this file to .env and configure if you wish to receive real-time notifications.

# Option 1: Discord Webhook URL (Recommended)
# WIKI_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Option 2: Discord Bot Token & Channel ID
# WIKI_DISCORD_BOT_TOKEN="your_bot_token_here"
# WIKI_DISCORD_CHANNEL_ID="your_channel_id_here"
